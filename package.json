  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "phaser": "^3.90.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tiktok-live-api": "^1.4.9",
    "vite": "^7.1.3",
    "ws": "^8.18.3"
  }
}
